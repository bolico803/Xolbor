PORT=5897
HOST=127.0.0.1
NODE_ENV=development
TRUST_PROXY=0
PUBLIC_ORIGIN=https://xolbor.ma
PUBLIC_WWW_ORIGIN=https://www.xolbor.ma
DATABASE_PATH=./runtime/xolbor.sqlite
BACKUP_DIR=./runtime/backups
ROOM_CAPACITY=16
# EMAIL_USER and EMAIL_PASS are optional. Email verification is not implemented yet.
# EMAIL_USER=
# EMAIL_PASS=
# Payments are disabled in phase 1. Do not add payment keys until verified webhooks are implemented.

# Limites de capacité par instance (bornes MAX_ROOMS=1..500, MAX_SOCKETS_PER_USER=1..20)
MAX_ROOMS=100
MAX_SOCKETS_PER_USER=4

# Paiements de test uniquement ; ne jamais mettre de clés actives ici.
XUBOR_TEST_PAYMENTS=0
